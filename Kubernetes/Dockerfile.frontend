# ---------- Build ----------
FROM node:18 AS build

WORKDIR /app

# Copy your entire project into the container
COPY . .

# Go into frontend
WORKDIR /app/FreshFork-Frontend

# Install deps & build
RUN npm ci --legacy-peer-deps
RUN npm run build

# ---------- Serve ----------
FROM nginx:alpine

# Clean default nginx static content
RUN rm -rf /usr/share/nginx/html/*

# Copy React build from local build stage
COPY --from=build /app/FreshFork-Frontend/dist /usr/share/nginx/html/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
