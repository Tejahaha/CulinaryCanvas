# Build frontend from local FreshFork-Frontend folder (build context must be repo root)
ARG REACT_APP_BACKEND_URL=http://freshfork-backend:8083
ARG VITE_BASE=/

FROM node:18 AS build
ARG REACT_APP_BACKEND_URL
ARG VITE_BASE

WORKDIR /app

# Copy only frontend sources (fast, avoids copying whole repo twice)
COPY FreshFork-Frontend/ ./FreshFork-Frontend/

WORKDIR /app/FreshFork-Frontend

# Pass the backend url into the build environment for Vite
ENV VITE_BACKEND_URL=${REACT_APP_BACKEND_URL}

# Install and build (use npm install to avoid requiring package-lock.json)
RUN npm install --legacy-peer-deps
RUN npm run build -- --base ${VITE_BASE}

# ---------- Serve ----------
FROM nginx:alpine

# Remove default nginx content and copy production build
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/FreshFork-Frontend/dist /usr/share/nginx/html/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
