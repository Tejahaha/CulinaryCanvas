# ---------- build ----------
FROM node:18 AS build
WORKDIR /app

RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

RUN git clone --depth=1 https://github.com/Tejahaha/CulinaryCanvas.git .
WORKDIR /app/FreshFork-Frontend

RUN npm ci --legacy-peer-deps
RUN npm run build

# ---------- runtime ----------
FROM nginx:alpine

RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/FreshFork-Frontend/dist/ /usr/share/nginx/html/

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
