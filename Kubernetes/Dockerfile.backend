# Stage 1: build with Maven (no slow apt-get)
FROM maven:3.9.6-eclipse-temurin-17 AS build
WORKDIR /app

# Shallow clone your repo
RUN git clone --depth=1 https://github.com/Tejahaha/CulinaryCanvas.git .

# Build backend artifact
WORKDIR /app/FreshFork-Backend
RUN mvn clean package -DskipTests

# Stage 2: runtime (Tomcat)
FROM tomcat:9.0-jdk17-temurin
RUN rm -rf /usr/local/tomcat/webapps/*
COPY --from=build /app/FreshFork-Backend/target/*.war /usr/local/tomcat/webapps/ROOT.war

EXPOSE 8080
CMD ["catalina.sh", "run"]
