# Build backend from local FreshFork-Backend folder (build context must be repo root)
FROM maven:3.9.6-eclipse-temurin-17 AS build

WORKDIR /app

# Copy backend source into image (must run docker build from repo root)
COPY FreshFork-Backend/ ./FreshFork-Backend/

WORKDIR /app/FreshFork-Backend

# Build Spring Boot JAR
RUN mvn -q -DskipTests package

# ---------- Runtime ----------
FROM eclipse-temurin:17-jre

WORKDIR /app

# Copy compiled app jar from the build stage
COPY --from=build /app/FreshFork-Backend/target/*.jar app.jar

# Make Spring Boot listen on 0.0.0.0 and default port
ENV SERVER_PORT=8083
EXPOSE 8083

# Pass server.port to JVM to ensure it listens on desired port
ENTRYPOINT ["sh", "-c", "java -jar /app/app.jar --server.port=${SERVER_PORT}"]
